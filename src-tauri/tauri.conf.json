{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Daymark",
  "version": "0.1.0",
  "identifier": "com.daymark.productivity",
  "build": { "beforeDevCommand": "npm run dev", "devUrl": "http://localhost:1420", "beforeBuildCommand": "npm run build", "frontendDist": "../dist" },
  "app": { "windows": [{ "label": "main", "title": "Daymark", "width": 1180, "height": 820, "minWidth": 980, "minHeight": 700, "resizable": true }, { "label": "pet", "title": "Daymark Pet", "width": 132, "height": 132, "transparent": true, "decorations": false, "alwaysOnTop": true, "skipTaskbar": true, "visible": false, "focus": false, "shadow": false }], "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src ipc: http://ipc.localhost" } },
  "bundle": { "active": true, "targets": "all", "icon": ["icons/icon.png", "icons/icon.icns"], "macOS": { "minimumSystemVersion": "12.0", "entitlements": "Entitlements.plist" } }
}
