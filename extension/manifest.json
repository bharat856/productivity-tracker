{
  "manifest_version": 3,
  "name": "Daymark for Brave",
  "version": "0.1.0",
  "description": "Private website time tracking for Daymark. Never reads page content.",
  "permissions": ["tabs", "idle", "storage", "nativeMessaging"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "Daymark" },
  "incognito": "not_allowed"
}
